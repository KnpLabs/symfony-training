{% extends 'base.html.twig' %}

{% block title %}Species{% endblock %}

{% block stylesheets %}
{{ parent() }}
<link rel="stylesheet" href="{{ asset('css/dinosaurs.css') }}" />
{% endblock %}

{% block body %}
<main>
  <div class="list-group">
    {% for species in speciesList %}
    {% if not is_granted('ROLE_ADMIN') %}
      <div class="list-group-item list-group-item-action d-flex gap-3 py-3 disabled-link">
    {% else %}
      <a class="list-group-item list-group-item-action d-flex gap-3 py-3" href="{{ path('app_edit_species', {id: species.id}) }}">
    {% endif %}
      <img
        src="{{ asset('img/dino.png') }}"
        alt="twbs"
        width="32"
        height="32"
        class="rounded-circle flex-shrink-0"
      >
      <div class="d-flex gap-2 w-100 justify-content-between">
        {{ species.name }}
      </div>
    {% if not is_granted('ROLE_ADMIN') %}
      </div>
    {% else %}
      </a>
    {% endif %}
    {% endfor %}
  </div>
</main>
{% endblock %}
